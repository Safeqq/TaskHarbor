# Keep real secrets in .env, which is ignored by Git.
TASKHARBOR_BIND_ADDR=127.0.0.1:3000
DATABASE_URL=postgres://taskharbor:taskharbor_dev@127.0.0.1:5432/taskharbor
TEST_DATABASE_URL=postgres://taskharbor:taskharbor_dev@127.0.0.1:5432/taskharbor_test
TASKHARBOR_DB_PASSWORD=taskharbor_dev
TASKHARBOR_POSTGRES_PORT=55432
TASKHARBOR_STORAGE_DIR=var/storage
TASKHARBOR_OWNER_USERNAME=owner
TASKHARBOR_OWNER_PASSWORD=
TASKHARBOR_SESSION_TTL_SECONDS=43200
TASKHARBOR_SECURE_COOKIES=false
TASKHARBOR_ALLOW_REMOTE=false
TASKHARBOR_STORAGE_BUDGET_BYTES=1073741824
TASKHARBOR_MAX_ACTIVE_JOBS=100
TASKHARBOR_LOGIN_ATTEMPTS_PER_MINUTE=5
TASKHARBOR_UPLOADS_PER_MINUTE=10
TASKHARBOR_MAX_BLOCKING_TASKS=2
TASKHARBOR_WORKER_NAME=worker-local
TASKHARBOR_WORKER_CONCURRENCY=2
TASKHARBOR_LEASE_SECONDS=15
TASKHARBOR_LEASE_RENEWAL_SECONDS=5
TASKHARBOR_HEARTBEAT_SECONDS=2
TASKHARBOR_HEARTBEAT_TTL_SECONDS=10
TASKHARBOR_SHUTDOWN_GRACE_SECONDS=30
TASKHARBOR_MAINTENANCE_SECONDS=3600
TASKHARBOR_OUTPUT_RETENTION_SECONDS=604800
TASKHARBOR_ORPHAN_GRACE_SECONDS=3600
RUST_LOG=info
